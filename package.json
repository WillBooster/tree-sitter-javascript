{
  "name": "@willbooster/tree-sitter-javascript",
  "version": "0.0.0-semantically-released",
  "description": "JavaScript grammar for tree-sitter",
  "keywords": [
    "incremental",
    "javascript",
    "parsing",
    "tree-sitter"
  ],
  "license": "MIT",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-javascript.git"
  },
  "files": [
    "grammar.js",
    "grammars/script/grammar.js",
    "grammars/script/src/node-types.json",
    "tree-sitter.json",
    "queries/*",
    "src/node-types.json",
    "*.wasm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build-wasm": "script/generate --build-wasm",
    "build/ci": "bun run build-wasm",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "generate": "script/generate",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "prestart": "bun run build-wasm",
    "start": "script/tree-sitter playground",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "test/ci-setup": "playwright install --with-deps chromium",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.3",
    "@willbooster/web-tree-sitter": "13.0.0",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "semantic-release": "25.0.9",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "peerDependencies": {
    "@willbooster/web-tree-sitter": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "@willbooster/web-tree-sitter": {
      "optional": true
    }
  }
}

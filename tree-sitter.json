{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "javascript",
      "camelcase": "JavaScript",
      "scope": "source.js",
      "path": ".",
      "file-types": ["js", "mjs", "jsx"],
      "highlights": ["queries/highlights.scm", "queries/highlights-jsx.scm", "queries/highlights-params.scm"],
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(js|javascript)$",
      "external-files": ["src/function_context.h"]
    },
    {
      "name": "javascript_script",
      "camelcase": "JavaScriptScript",
      "scope": "source.js.script",
      "path": "grammars/script",
      "file-types": ["cjs"],
      "highlights": ["queries/highlights.scm", "queries/highlights-jsx.scm", "queries/highlights-params.scm"],
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^javascript-script$",
      "external-files": ["src/scanner.c", "src/function_context.h"]
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "JavaScript grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-javascript"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
